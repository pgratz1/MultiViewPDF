# Copy to `.env` (git-ignored) at the repo root. Gradle bakes these into BuildConfig at build time,
# so every freshly installed debug build already has the Anthropic key for Claude figure descriptions.
# A key entered in the app under ⋮ → "Read-aloud settings…" takes precedence over this one.
# Create a key at https://platform.claude.com. Note: the key ends up in plain text inside the APK.
ANTHROPIC_API_KEY=sk-ant-...
