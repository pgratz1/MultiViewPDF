<?xml version="1.0" encoding="utf-8"?>
<!-- prefs/app.json holds the Claude API key: keep it out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="prefs/app.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="prefs/app.json" />
    </device-transfer>
</data-extraction-rules>
